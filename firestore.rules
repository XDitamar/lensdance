rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Prefer a custom claim (admin: true); keep the known email as a bootstrap
      // fallback so admin access never breaks before the claim is set.
      return request.auth != null
        && (request.auth.token.admin == true
            || request.auth.token.email == "lensdance29@gmail.com");
    }

    // ---- users (Admin sync) ----
    match /users/{userId} {
      // The admin can read every profile and edit any profile (title / cover).
      allow read, write: if isAdmin();
      // Each user can read and edit their own profile.
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // ---- downloads (per-user download history) ----
    match /downloads/{docId} {
      // Any signed-in user may log a download; only the admin can read them.
      allow create: if request.auth != null;
      allow read:   if isAdmin();
      allow update, delete: if false;
    }

    // ---- registrations (competition sign-ups) ----
    match /registrations/{docId} {
      allow create: if request.auth != null;
      allow read:   if isAdmin();
      // The admin marks the 40% deposit as paid from /admin/registrations.
      // Narrowed to that one field on purpose: a sign-up is a record of what
      // the rider submitted and must not become editable after the fact, so
      // nobody — admin included — can quietly rewrite a name, a package or a
      // publishing permission. Deleting stays closed.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['depositPaid', 'depositPaidAt']);
      allow delete: if false;
    }

    // ---- priorityCounts (priority delivery places taken, per competition) ----
    // One document per competition holding a single number. It exists so the
    // sign-up form can show "2 of 5 places left" without giving riders read
    // access to `registrations`, which holds everyone else's name, contact
    // details and publishing choice.
    //
    // A signed-in rider may claim a place: create the tally at 1, or move `used`
    // up by exactly one, never past the cap. That cap is duplicated from
    // PRIORITY_SLOTS in src/config/pricing.js — the two must be changed
    // together, and the rule is the one that actually enforces it.
    match /priorityCounts/{competitionKey} {
      allow read:  if true;
      allow write: if isAdmin();

      allow create: if request.auth != null
                    && request.resource.data.used == 1;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['used', 'updatedAt'])
                    && request.resource.data.used == resource.data.used + 1
                    && request.resource.data.used <= 5;
    }

    // ---- agreements ----
    match /agreements/{docId} {
      allow create, read: if request.auth != null;
      allow update, delete: if false;
    }

    // ---- mediaGallery ----
    match /mediaGallery/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ---- settings (competition title, etc.) ----
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- secrets (server-only: Instagram access token, etc.) ----
    // Explicitly closed to every client, including the admin. Only the
    // firebase-admin SDK in api/ (which bypasses rules) may read or write here.
    match /secrets/{docId} {
      allow read, write: if false;
    }

    // ברירת מחדל – הכל חסום
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
